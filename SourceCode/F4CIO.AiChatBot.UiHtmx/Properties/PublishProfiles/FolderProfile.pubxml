<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio: right-click the UiHtmx project -> Publish -> FolderProfile.
  Produces a self-contained single-file output in ..\Published\F4CIO.AiChatBot.UiHtmx
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<Configuration>Release</Configuration>
	<Platform>Any CPU</Platform>
	<PublishProtocol>FileSystem</PublishProtocol>
	<_TargetId>Folder</_TargetId>
	<TargetFramework>net10.0</TargetFramework>
	<!-- Match UiApi publish settings: self-contained Windows RID and not single-file. -->
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishReadyToRun>false</PublishReadyToRun>
	<PublishReadyToRun>false</PublishReadyToRun>
	<PublishDir>..\..\Published\F4CIO.AiChatBot.UiHtmx\</PublishDir>
  </PropertyGroup>
</Project>
